{
  "manifest_version": 3,
  "name": "VOIDSCAN Reaction Audit",
  "version": "0.2.0",
  "description": "Tự cuộn và phân loại reaction đang hiển thị, xuất CSV/JSON, bảng nổi kéo thả",
  "action": {
    "default_title": "VOIDSCAN Reaction Audit",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "minimum_chrome_version": "110"
}