{
  "manifest_version": 3,
  "name": "VOIDSCAN Reaction Audit",
  "version": "0.4.4",
  "description": "Tách dữ liệu theo từng ảnh Facebook, nhập CSV và rà soát tín hiệu từ dữ liệu",
  "action": {
    "default_title": "VOIDSCAN Reaction Audit",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads"
  ],
  "minimum_chrome_version": "110"
}