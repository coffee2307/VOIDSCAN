# No tokens belong in Git. These are example environment variable names only.
# Option A: a USER token with pages_show_list, pages_read_engagement and,
# where required, pages_read_user_content for Page comments.
META_USER_ACCESS_TOKEN=
# Option B: a PAGE token, plus the exact Page ID. Choose one option.
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
# Local-only server port (binds to 127.0.0.1).
VOIDSCAN_PORT=3000
# Optional isolated data directory for tests.
# VOIDSCAN_DATA_DIR=F:/VOIDSCAN/data
